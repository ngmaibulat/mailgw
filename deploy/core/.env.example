# Core node config — copy to deploy/core/.env and fill in real secrets.
# deploy/core/.env is gitignored (the repo .gitignore ignores .env).

# This host's address as the EDGE NODES see it (IP or DNS name, no scheme).
# It is baked into the config bundles Central Management hands to gateways as
# their logservice URL, so "localhost" is wrong here unless everything is on
# one box.
CORE_HOST=change-me

# Shared secret between this logservice and every edge mailgw-go node.
# Generate one with: openssl rand -hex 32
API_KEY=change-me

# Signs the webui's session cookie. Rotating it logs everyone out.
# Generate one with: openssl rand -hex 32
SIGN_COOKIE=change-me

# Encrypts relay passwords at rest in the database (AES-256-GCM). The console
# decrypts them when it composes a gateway's config bundle, so this key never
# leaves this host and no gateway ever holds it.
#
# Leave it empty and passwords are stored in the clear, exactly as before —
# nothing breaks, but a database backup carries somebody else's credentials.
# Rotating it makes existing passwords unreadable: re-enter them in the UI, or
# keep the old key.
#
# Generate one with: openssl rand -base64 32
CONFIG_SECRET_KEY=

# Bearer token every edge node will require on its own /metrics and /readyz.
# Central Management writes it into each gateway's config bundle, because an
# edge node has no environment of its own to read it from.
#
# Leave it empty and those endpoints stay open, exactly as before — the firewall
# rule on the gateway (deploy/gateway/05-firewall.sh) is what covers them then.
# Set it and your Prometheus scrape config needs:
#   authorization: { type: Bearer, credentials: <this value> }
# /healthz stays open either way, so container health checks keep working.
#
# Generate one with: openssl rand -hex 32
GATEWAY_METRICS_TOKEN=

# MariaDB
DB_NAME=mailgw
DB_USER=mailgw
DB_PASS=change-me
DB_ROOT_PASS=change-me
