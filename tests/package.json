{
  "name": "@aibulat/mailgw-tests",
  "version": "0.1.0",
  "description": "End-to-end test suite for mailgw (SMTP pipeline + logservice HTTP API)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test ./api/ ./smtp/ ./gw/ ./stack/",
    "test:api": "bun test ./api/",
    "test:smtp": "bun test ./smtp/",
    "test:gw": "bun test ./gw/",
    "test:stack": "bun test ./stack/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "send": "bun run smtp/src/send.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
