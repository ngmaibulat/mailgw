{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["api/**/*", "smtp/**/*", "gw/**/*", "stack/**/*", "harness/**/*", "*.ts"]
}
