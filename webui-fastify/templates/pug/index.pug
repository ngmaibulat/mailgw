extends page.pug

block content
  section.dash-hero
    p.page-eyebrow SMTP gateway console
    h1 Mail Router
    p Inbound mail, routing, and attachment filtering at a glance.

  //- Live feed of the most recent deliveries (newest first). The most
  //- characteristic thing in this product is mail actually moving, so it leads.
  .feed-card
    .feed-head
      span.feed-label
        span.live-dot
        | Recent deliveries
      a.btn.btn-ghost(href='/log/delivery')
        +icon('arrow')
        span Open log
    if feed.unavailable
      .feed-empty Delivery log is unavailable. Check that logservice is reachable.
    else if !feed.rows.length
      .feed-empty No deliveries recorded yet.
    else
      table.data-table
        thead
          tr
            th Time
            th Sender
            th Recipients
            th Relay
            th Response
        tbody
          each row in feed.rows
            -
              var resp = String(row.response || '');
              var code = (resp.match(/\d{3}/) || [''])[0];
              var pill = code.charAt(0) === '2' ? 'pill-ok' : (code.charAt(0) === '4' ? 'pill-warn' : (code.charAt(0) === '5' ? 'pill-err' : ''));
            tr
              td.mono= row.dt ? String(row.dt).slice(0, 19) : '—'
              td.mono= row.sender || '—'
              td.mono= row.rcpt_list || '—'
              td.mono= row.host || '—'
              td
                if code
                  span.pill(class=pill)= code
                else
                  | —

  //- Fleet health. Everything here is "should you go and look, and at what" —
  //- the detail lives on /gateways. Pending approvals lead because they are the
  //- only item that cannot resolve itself without a human.
  .feed-card
    .feed-head
      span.feed-label
        span.live-dot
        | Gateway fleet
      a.btn.btn-ghost(href='/gateways')
        +icon('arrow')
        span Open fleet
    if fleet.unavailable
      .feed-empty Fleet status is unavailable. Check the database connection.
    else if !fleet.summary.total
      .feed-empty No gateways have registered yet.
    else
      .fleet-body
        .fleet-counts
          .fleet-count
            span.fleet-n= fleet.summary.total
            span.fleet-label Registered
          .fleet-count
            span.fleet-n.ok= fleet.summary.approved
            span.fleet-label Approved
          if fleet.summary.other
            .fleet-count
              span.fleet-n= fleet.summary.other
              span.fleet-label Rejected or revoked

        if fleet.summary.pending
          a.fleet-alert.fleet-alert-pending(href='/gateways')
            strong= fleet.summary.pending
            |  #{fleet.summary.pending === 1 ? 'gateway is' : 'gateways are'} waiting for approval
            span.fleet-alert-hint Approve a fingerprint to let it pull its configuration.

        each row in fleet.summary.errored
          a.fleet-alert.fleet-alert-err(href='/gateways/' + row.id)
            strong= row.name || row.hostname || ('gateway ' + row.id)
            |  could not apply its configuration
            span.fleet-alert-hint= row.apply_error

        each row in fleet.summary.stale
          a.fleet-alert.fleet-alert-warn(href='/gateways/' + row.id)
            strong= row.name || row.hostname || ('gateway ' + row.id)
            |  has not reported recently
            span.fleet-alert-hint Last seen #{row.last_seen ? String(row.last_seen.toISOString()).slice(0, 19).replace('T', ' ') : 'never'}.

        each row in fleet.summary.needRestart
          a.fleet-alert.fleet-alert-warn(href='/gateways/' + row.id)
            strong= row.name || row.hostname || ('gateway ' + row.id)
            |  needs a restart to finish applying its configuration

        if fleet.summary.healthy
          p.fleet-ok All gateways are approved, current and reporting.

  p.page-eyebrow Sections
  .section-grid
    a.section-card(href='/log/delivery')
      span.sc-icon
        +icon('activity')
      span
        p.sc-title Delivery log
        p.sc-desc Outcome of every relayed message
    a.section-card(href='/log/connection')
      span.sc-icon
        +icon('plug')
      span
        p.sc-title Connections
        p.sc-desc Inbound SMTP connections
    a.section-card(href='/log/lookups')
      span.sc-icon
        +icon('hash')
      span
        p.sc-title Hash lookups
        p.sc-desc Attachment MD5 filter checks
    a.section-card(href='/config/relaygrp')
      span.sc-icon
        +icon('mail')
      span
        p.sc-title Relays
        p.sc-desc Relay groups and targets
    a.section-card(href='/gateways')
      span.sc-icon
        +icon('plug')
      span
        p.sc-title Gateways
        p.sc-desc Registered instances and deploys
    a.section-card(href='/config/profiles')
      span.sc-icon
        +icon('route')
      span
        p.sc-title Config profiles
        p.sc-desc Rulesets, allowlists, server settings
    a.section-card(href='/users')
      span.sc-icon
        +icon('users')
      span
        p.sc-title Users
        p.sc-desc Console login accounts
