extends ../page.pug
block content
  +pageHeader('Delete credential set')
  .alert.alert-danger
    | Deleting a set deletes every credential in it. Any gateway assigned this
    | set keeps working on its currently deployed configuration until its next
    | Deploy, at which point those logins stop being accepted.
  .card.form-card
    .card-body
      form#frm(method='POST')
        .form-field
          label(for='name') Name
          input#name.form-control(type='text' value=`${data.name}` disabled='')
        .form-field
          label(for='description') Description
          input#description.form-control(type='text' value=`${data.description || ''}` disabled='')
        .form-actions
          button#btn_submit.btn.btn-danger(type='submit') Delete
          a.btn.btn-ghost(href='/config/credentials') Cancel
