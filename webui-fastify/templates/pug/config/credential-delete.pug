extends ../page.pug
block content
  +pageHeader('Delete credential')
  .alert.alert-danger This login stops being accepted on the next Deploy to any gateway assigned this set.
  .card.form-card
    .card-body
      form#frm(method='POST')
        .form-field
          label(for='username') Username
          input#username.form-control(type='text' value=`${data.username}` disabled='')
        .form-actions
          button#btn_submit.btn.btn-danger(type='submit') Delete
          a.btn.btn-ghost(href=`/config/credentials/${data.set_id}`) Cancel
