extends ../page.pug
block content
  +pageHeader('SMTP credentials', 'inbound AUTH logins, assigned to gateways as a set')
    a.btn.btn-accent(href='/config/credentials/create')
      +icon('plus')
      span Add set
  p.muted
    | These are the credentials a submission client presents
    strong  to
    |  a gateway — not the ones a gateway presents to a relay, which live on
    |  the relay itself. Passwords are hashed here and never stored or sent in
    |  a recoverable form. A gateway only advertises AUTH once a set is
    |  assigned and deployed, and only over an encrypted session unless
    code  tls.allow_insecure_auth
    |  says otherwise.
  table.data-table
    thead
      tr
        th.num ID
        th Name
        th Description
        th.col-actions Actions
    tbody
      if !data || !data.length
        tr.empty-row: td(colspan='4') No credential sets yet.
      each row in data
        tr
          td.num= row.id
          td: a(href=`/config/credentials/${row.id}`)= row.name
          td= row.description
          td.col-actions
            a.act.act-edit(href=`/config/credentials/edit/${row.id}` title='Edit')
              +icon('edit')
            a.act.act-del(href=`/config/credentials/delete/${row.id}` title='Delete')
              +icon('trash')
