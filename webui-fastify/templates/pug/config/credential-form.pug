extends ../page.pug
block content
  +pageHeader(`${action} credential`)
  if error
    .alert.alert-danger= error
  .card.form-card
    .card-body
      form#frm(method='POST')
        .form-field
          label(for='username') Username
          input#username.form-control(type='text' name='username' value=`${data.username || ''}` required='' autocomplete='off')
          small.form-hint Compared exactly as typed — a submission credential is an opaque string, not a mailbox.
        .form-field
          label(for='password') Password
          input#password.form-control(type='password' name='password' value='' autocomplete='new-password' placeholder=(action == 'Update' ? 'Leave blank to keep current' : ''))
          small.form-hint
            | Hashed with bcrypt before it is stored, and never shown again.
            | At least 12 characters and at most 72 bytes — bcrypt ignores
            | anything past that.
        .form-actions
          button#btn_submit.btn.btn-accent(type='submit')= action
          a.btn.btn-ghost(href=`/config/credentials/${set_id}`) Cancel
