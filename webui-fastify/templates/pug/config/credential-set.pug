extends ../page.pug
block content
  +pageHeader(`Credential set: ${set.name}`, set.description)
    a.btn.btn-accent(href=`/config/credential/create/${set.id}`)
      +icon('plus')
      span Add credential
  p.muted
    | Changes here take effect on a gateway at its next Deploy. Revoking a
    | credential is a delete followed by a Deploy — a gateway reads its
    | credentials on every AUTH command, so the revocation lands on the next
    | attempt rather than on the next restart.
  table.data-table
    thead
      tr
        th.num ID
        th Username
        th Password
        th.col-actions Actions
    tbody
      if !users || !users.length
        tr.empty-row: td(colspan='4') No credentials in this set.
      each row in users
        tr
          td.num= row.id
          td= row.username
          td.muted stored as a bcrypt hash
          td.col-actions
            a.act.act-edit(href=`/config/credential/edit/${row.id}` title='Edit')
              +icon('edit')
            a.act.act-del(href=`/config/credential/delete/${row.id}` title='Delete')
              +icon('trash')
  p
    a.btn.btn-ghost(href='/config/credentials') Back to credential sets
