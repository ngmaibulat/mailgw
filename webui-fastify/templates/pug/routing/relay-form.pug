extends ../page.pug
block content
  +pageHeader(`${action} relay`, data.host)
  if error
    .alert.alert-danger= error
  .card.form-card
    .card-body
      form#frm(method='POST')
        input(type='hidden' name='group_id' value=`${group_id}` required='')
        .form-field
          label(for='host') Host
          input#host.form-control(type='text' name='host' value=`${data.host}` required='')
        .form-field
          label(for='port') Port
          input#port.form-control(type='number' name='port' value=`${data.port}` required='')
        .form-field
          label(for='priority') Priority
          input#priority.form-control(type='number' name='priority' value=`${data.priority}` required='')
        .form-field
          label(for='auth_user') User
          input#auth_user.form-control(type='text' name='auth_user' value=`${data.auth_user}`)
        .form-field
          label(for='auth_pass') Password
          input#auth_pass.form-control(type='password' name='auth_pass' value='' placeholder=(action == 'Update' ? 'Leave blank to keep current' : ''))
          small.form-hint Encrypted at rest when CONFIG_SECRET_KEY is set. It is decrypted here when a gateway bundle is composed, so no key ever reaches a gateway.
        .form-field
          label(for='tls') Outbound TLS
          select#tls.form-control(name='tls')
            option(value='' selected=!data.tls) opportunistic (default)
            option(value='opportunistic' selected=data.tls == 'opportunistic') opportunistic
            option(value='required' selected=data.tls == 'required') required
            option(value='none' selected=data.tls == 'none') none
        .form-field
          label.form-check(for='allow_insecure_auth')
            input#allow_insecure_auth(type='checkbox' name='allow_insecure_auth' value='1' checked=!!data.allow_insecure_auth)
            |  Allow AUTH without TLS
          small.form-hint Sends the relay password in the clear. Leave off unless the relay is reached over a trusted link.
        .form-field
          label.form-check(for='use_mx')
            input#use_mx(type='checkbox' name='use_mx' value='1' checked=!!data.use_mx)
            |  Resolve host as a domain (MX lookup)
          small.form-hint Treats Host as a domain, looks up its MX records at delivery time and tries them in preference order. Each inherits this relay's port, credentials and TLS policy. This does not deliver to the recipient's own domain.
        .form-actions
          button#btn_submit.btn.btn-accent(type='submit')= action
          a.btn.btn-ghost(href=`/config/relaygrp/${group_id}`) Cancel
